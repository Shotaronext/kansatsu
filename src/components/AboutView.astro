---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { LANGS, UI, aboutUrl, indexUrl, excerpt, type Lang } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const entry = (await getEntry('about', lang)) ?? (await getEntry('about', 'ja'))!;
const { Content } = await render(entry);
const alternates = Object.fromEntries(LANGS.map((l) => [l, aboutUrl(l)])) as Record<Lang, string>;
---
<Base lang={lang} title={`${entry.data.title} | 観察`} description={excerpt(entry.body, lang)} alternates={alternates}>
  <main class="col post">
    <img class="hero" src="/img/train.webp" alt="海沿いを走る電車の車内。窓際の席で、帽子をかぶった男性が窓の外の海を見ている。">
    <p class="stamp">{entry.data.stamp}</p>
    <h1>{entry.data.title}</h1>
    <p class="place">{entry.data.place}</p>
    <div class="body" lang={lang}><Content /></div>
    <a class="back" href={indexUrl(lang)}>{UI.back[lang]}</a>
  </main>
</Base>
